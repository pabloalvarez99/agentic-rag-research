# Template: variable names only, never values. Copy to .env for local overrides.
# .env is gitignored; a real key belongs there, or in your shell, and nowhere else.
#
# Every variable here is optional. The default path is the deterministic local
# one, which needs no credential and no running service.

# Root of a running production-rag instance, e.g. http://127.0.0.1:8000.
# Set, the retrieve tool queries it at POST /v1/query with the free providers
# pinned. Unset or empty, retrieval is the in-process fake backend.
PRODUCTION_RAG_URL=

# Optional hosted generation provider. Leave empty to stay on the free path.
OPENAI_API_KEY=
