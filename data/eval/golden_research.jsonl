{"schema_version": "1.0.0", "id": "insufficient-evidence-what-is-a-citation", "category": "no_evidence_refusal", "question": "What is a citation?", "max_steps": 5, "top_k": 1, "expected_terminal_status": "refused", "expected_stop_reason": "insufficient_evidence", "expected_min_citations": 1, "expected_max_citations": 1, "expected_source_paths": ["docs/answers.md"], "expected_chunk_ids": ["citations-1"], "expected_min_plan_size": 1, "expects_repeated_evidence": false, "normalization_group": null, "rationale": "The single question term is covered, so the critic emits a thin_evidence gap carrying no follow-up; the queue is empty after one step and four steps of budget remain unspent."}
